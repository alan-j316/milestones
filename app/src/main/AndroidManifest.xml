<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--  SENDING SMS is an optional feature  -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission
        android:name="android.permission.SEND_SMS"
        tools:ignore="SmsAndCallLogPolicy" />

    <application
        android:name=".MilestoneApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeightTracker">
        <activity
            android:name=".presentation.login.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.WeightTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.register.RegisterActivity"
            android:exported="true"
            android:theme="@style/Theme.WeightTracker"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".presentation.home.HomeActivity"
            android:exported="true"
            android:theme="@style/Theme.WeightTracker"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".presentation.profile.ProfileActivity"
            android:exported="true"
            android:theme="@style/Theme.WeightTracker"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".presentation.goals.GoalsActivity"
            android:exported="true"
            android:theme="@style/Theme.WeightTracker"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>