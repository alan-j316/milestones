<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/space_lg"
    android:layout_marginBottom="@dimen/space_md">

    <TextView
        android:id="@+id/tvHomeGreeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/greeting_morning"
        android:textSize="@dimen/fs_3xl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHomeFullName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tvHomeUsername"
        android:textSize="@dimen/fs_3xl"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tvHomeGreeting"
        app:layout_constraintTop_toBottomOf="@id/tvHomeGreeting" />

    <ImageView
        android:id="@+id/imgHomeProfile"
        android:layout_width="@dimen/min_interactive_size"
        android:layout_height="@dimen/min_interactive_size"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginEnd="@dimen/space_sm"
        android:backgroundTint="@color/transparent"
        android:contentDescription="@string/go_to_profile_page"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/account_icon"
        app:tint="@color/slate_600" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHomeFullName">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:backgroundTint="@color/red_500"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutHomeProgressView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvHomeStartingWeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:text="@string/weight_format"
                        android:textAlignment="center"
                        android:textColor="@color/slate_700"
                        android:textSize="@dimen/fs_lg"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbHomeWeightChange"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:maxWidth="@dimen/progress_max_width"
                        android:minWidth="@dimen/progress_min_width"
                        android:progress="50"
                        android:progressTint="@color/mint_500" />

                    <TextView
                        android:id="@+id/tvHomeGoalWeight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:text="@string/weight_format"
                        android:textAlignment="center"
                        android:textColor="@color/slate_700"
                        android:textSize="@dimen/fs_lg"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHomeCurrentWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_marginTop="@dimen/space_3xs"
                    android:text="@string/weight_format"
                    android:textAlignment="center"
                    android:textColor="@color/slate_700"
                    android:textSize="@dimen/fs_xl"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnHomeTrackWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_sm"
                android:layout_marginTop="@dimen/space_md"
                android:maxWidth="@dimen/max_btn_width"
                android:text="@string/track_weight" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/mint_500"
            android:orientation="vertical">

            <TextView
                android:id="@+id/historyHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/your_progress_so_far"
                android:textColor="@color/slate_700"
                android:textSize="@dimen/fs_xl"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHomeHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/space_2xs"
                android:paddingHorizontal="@dimen/space_xs"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:itemCount="12"
                tools:listitem="@layout/weight_item" />

            <LinearLayout
                android:id="@+id/layoutHomeNoHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_xs">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/illustration_no_weights_height"
                    android:contentDescription="@string/no_history"
                    android:src="@drawable/illustration_empty" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/no_tracking_history"
                    android:textColor="@color/slate_900"
                    android:textSize="@dimen/fs_2xl"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3xs"
                    android:text="@string/no_weight_history_text"
                    android:textColor="@color/slate_900"
                    android:textSize="@dimen/fs_md" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingHomeLayout"
        android:layout_width="@dimen/loader_width"
        android:layout_height="wrap_content"
        android:background="@color/primary_50"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:paddingVertical="@dimen/space_lg"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/space_md" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/loading"
            android:textSize="@dimen/fs_lg" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>